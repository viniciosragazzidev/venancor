# =====================================================================
# MedLink: variáveis de ambiente
# Copie para .env (local) e preencha. NUNCA commite o .env.
# Na Vercel: mesmas chaves em Settings > Environment Variables.
# =====================================================================

# ---------------------------------------------------------------------
# Banco (Supabase Postgres)
# Local / migrations: session pooler, porta 5432.
# Vercel (serverless): transaction pooler, porta 6543.
# Se a senha tiver caracteres especiais, codifique na URL (@ vira %40, # vira %23).
# O nome do banco no fim é "postgres".
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# Autenticação (Better Auth)
# Secret: 32+ caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use um secret diferente em dev e em produção.
# ---------------------------------------------------------------------
BETTER_AUTH_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais
OTP_SECRET=troque-por-outro-segredo-aleatorio-de-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3000

# URL pública do app (usada nos links enviados ao cliente: APP_URL/c/<token>)
APP_URL=http://localhost:3000

# Primeiro usuário admin (lido pelo seed: npm run db:seed)
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# ---------------------------------------------------------------------
# Provedores (trocáveis). Em dev use fake/local: o fluxo inteiro roda
# sem Asaas, sem Meta e sem bucket.
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=fake          # fake | asaas
MESSAGING_PROVIDER=fake        # fake | meta
SIGNATURE_PROVIDER=inhouse     # inhouse (futuro: zapsign | clicksign)
STORAGE_DRIVER=local           # local | supabase

# ---------------------------------------------------------------------
# Pagamento: Asaas (quando PAYMENT_PROVIDER=asaas)
# Comece no sandbox. Chave em Asaas > Integrações > API.
# O token do webhook é o mesmo cadastrado em Asaas > Integrações > Webhooks.
# ---------------------------------------------------------------------
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------
# WhatsApp: Meta Cloud API (quando MESSAGING_PROVIDER=meta)
# Token permanente de usuário do sistema + App Secret (valida o webhook).
# ---------------------------------------------------------------------
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
META_VERIFY_TOKEN=
META_APP_SECRET=

# ---------------------------------------------------------------------
# Armazenamento: Supabase Storage (quando STORAGE_DRIVER=supabase)
# Bucket PRIVADO para contratos, assinaturas e evidências.
# A service role key é secreta: só no servidor, nunca em NEXT_PUBLIC_.
# ---------------------------------------------------------------------
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# E-mail reserva: Resend (opcional em dev)
# ---------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@seu-dominio.com
